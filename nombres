from data_handler import save_data

def add_student(students):
    try:
        student_id = input("Enter ID: ")

        for student in students:
            if student["id"] == student_id:
                print("Error: ID already exists.")
                return

        name = input("Enter name: ")
        age = int(input("Enter age: "))
        course = input("Enter course: ")
        status = input("Enter status (active/inactive): ").lower()

        student = {
            "id": student_id,
            "name": name,
            "age": age,
            "course": course,
            "status": status
        }

        students.append(student)
        save_data(students)
        print("Student added successfully.")

    except ValueError:
        print("Error: Age must be a number.")


def view_students(students):
    if not students:
        print("No students found.")
        return

    print("\n--- STUDENT LIST ---")
    for student in students:
        print(f"ID: {student['id']}, Name: {student['name']}, Age: {student['age']}, Course: {student['course']}, Status: {student['status']}")


def find_student(students):
    search = input("Enter ID or name: ").lower()

    for student in students:
        if student["id"] == search or student["name"].lower() == search:
            print(student)
            return

    print("Student not found.")


def update_student(students):
    student_id = input("Enter ID to update: ")

    for student in students:
        if student["id"] == student_id:
            print("Leave blank to keep current value.")

            name = input(f"New name ({student['name']}): ") or student['name']

            try:
                age_input = input(f"New age ({student['age']}): ")
                age = int(age_input) if age_input else student['age']
            except:
                age = student['age']

            course = input(f"New course ({student['course']}): ") or student['course']
            status = input(f"New status ({student['status']}): ") or student['status']

            student.update({
                "name": name,
                "age": age,
                "course": course,
                "status": status
            })

            save_data(students)
            print("Student updated successfully.")
            return

    print("Student not found.")


def delete_student(students):
    student_id = input("Enter ID to delete: ")

    for student in students:
        if student["id"] == student_id:
            students.remove(student)
            save_data(students)
            print("Student deleted successfully.")
            return

    print("Student not found.")